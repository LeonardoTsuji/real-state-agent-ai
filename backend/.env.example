NODE_ENV=development
PROCESS_ROLE=all
TRUST_PROXY_HOPS=0
PORT=3000
POSTGRES_USER=copilot
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_DB=corretor_copilot
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://copilot:local_only_change_me@localhost:5432/corretor_copilot?schema=public
REDIS_URL=redis://localhost:6379
# Gere localmente com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_DELAY_MS=1000
QUEUE_JOB_TIMEOUT_MS=15000
QUEUE_CONCURRENCY=5
QUEUE_RATE_MAX=30
QUEUE_RATE_DURATION_MS=1000
SIMULATED_CALENDAR_MODE=success
SIMULATED_MESSAGING_MODE=success
HTTP_BODY_LIMIT=100kb
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=120
RATE_LIMIT_USER_MAX=300
RATE_LIMIT_AI_USER_MAX=20
AI_PROVIDER=mock
# Defina AI_PROVIDER=openai e preencha a chave apenas no backend para habilitar o Responses API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_MAX_ITERATIONS=4
AI_MAX_TOOL_CALLS=8
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_TOTAL_TOKENS=5000
AI_MAX_CONTEXT_CHARS=14000
AI_DAILY_TOKEN_LIMIT=100000
AI_DAILY_REQUEST_LIMIT=200
AI_MESSAGE_RETENTION_DAYS=365
# Permite respostas de cliente e pagamentos demonstrativos; nunca conecta serviços reais.
DEMO_MODE=false
